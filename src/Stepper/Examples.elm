    , ( "voter1", "{\n  \"format\": \"parva-trace\",\n  \"version\": 1,\n  \"file\": \"voter1.pav\",\n  \"source\": \"void main () {                        $C+ $D+\\u000d\\u000a// simple voter example from book\\u000d\\u000a  const votingAge = 18;\\u000d\\u000a  int age, eligible = 0, total = 0;\\u000d\\u000a  bool allEligible = true;\\u000d\\u000a  int[] voters = new int[100];\\u000d\\u000a  read(age);\\u000d\\u000a  while (age > 0) {\\u000d\\u000a    bool canVote = age > votingAge;\\u000d\\u000a    allEligible = allEligible && canVote;\\u000d\\u000a    if (canVote) {\\u000d\\u000a      voters[eligible] = age;\\u000d\\u000a      eligible = eligible + 1;\\u000d\\u000a      total = total + voters[eligible - 1];\\u000d\\u000a    }\\u000d\\u000a    read(age);\\u000d\\u000a  }\\u000d\\u000a  write(eligible, \\\" voters.  Average age is \\\", total / eligible, \\\"\\\\n\\\");\\u000d\\u000a  if (allEligible) write(\\\"Everyone was above voting age\\\");\\u000d\\u000a  $HD $SD $ST\\u000d\\u000a}\\u000d\\u000a\",\n  \"maxT\": 53,\n  \"memSize\": 812,\n  \"terminals\": [\"EOF\",\"identifier\",\"number\",\"stringLit\",\"charLit\",\"void\",\"lparen\",\"rparen\",\"lbrace\",\"rbrace\",\"semicolon\",\"const\",\"comma\",\"true\",\"false\",\"null\",\"lbrackrbrack\",\"int\",\"bool\",\"char\",\"plusplus\",\"minusminus\",\"lbrack\",\"rbrack\",\"if\",\"else\",\"while\",\"do\",\"break\",\"halt\",\"read\",\"readLine\",\"write\",\"writeLine\",\"barbar\",\"andand\",\"plus\",\"minus\",\"bang\",\"new\",\"cap\",\"low\",\"length\",\"star\",\"slash\",\"percent\",\"equalequal\",\"bangequal\",\"less\",\"lessequal\",\"greater\",\"greaterequal\",\"equal\",\"NOT\",\"CodeOn\",\"CodeOff\",\"DebugOn\",\"DebugOff\",\"StackDump\",\"HeapDump\",\"TableDump\"],\n  \"types\": [\"none\",\"none[]\",\"null\",\"null[]\",\"int\",\"int[]\",\"bool\",\"bool[]\",\"char\",\"char[]\",\"void\",\"void[]\"],\n  \"ops\": [{\"name\":\"\",\"words\":1},{\"name\":\"NOP\",\"words\":1},{\"name\":\"DSP\",\"words\":2},{\"name\":\"